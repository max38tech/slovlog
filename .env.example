# Slovlog Environment Configuration

# Supabase Public Keys (Visible in browser)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Site URL for Vercel / Localhost OAuth redirects
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Supabase Server-Only Secret Key (Found in Supabase Dashboard -> Settings -> API -> service_role secret)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Protected Super-User / Owner Google Account Email
INITIAL_ADMIN_EMAIL="shawn.shiobara@gmail.com"
